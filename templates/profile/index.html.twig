{% extends 'base.html.twig' %}

{% block title %}Hello ProfileController!{% endblock %}

{% block body %}
    <main>
        <div class="container mt-3">
            <div class="row align-items-start">
                <div class="col-4">
                    {% if user.profilePicture is not null %}
                        <img src="{{ asset('uploads/profile_picture/' ~ user.profilePicture) }}" class="profile-Image">
                    {% else %}
                        <img src="{{ asset('uploads/profile_picture/defaultpfp.jpg') }}" class="profile-Image">
                    {% endif %}
                </div>
                <div class="col">
                    <h1>{{ user.username }}</h1>
                    <p>{{ user.bio }}</p>

                    {% if app.user and app.user.id and app.user.id == user.id %}
                        <a href="{{ path('app_edit_profile') }}" class="btn btn-success me-2">Edit Profile</a>
                        <a href="{{ path('logout') }}" class="btn btn-danger">Logout</a>
                    {% endif %}
                </div>
            </div>
            <div class="mt-5" id="reviewList">
                <h2>Your Reviews</h2>
                {% for review in  reviews %}
                    <div class="card mb-2">
                        <div class="card-body" style="background-color: var(--primary) !important; color: white !important; border-color: gray !important; border-radius: 5px !important;">
                            <p><b><a href="{{ path('app_view_album', { id: review.albumID.id }) }}">{{ review.albumID.albumName }}</a> &#x2022; {% if review.albumID.artistID is not null %}
                                        {{ review.albumID.artistID.name }}
                                    {% else %}
                                        UNKNOWN
                                    {% endif %}</b></p>
                            {% if review.reviewScore <= 1 %}
                                <h3 class="square" style="background-color: indianred;">{{ review.reviewScore }}</h3>
                            {% elseif review.reviewScore < 4 %}
                                <h3 class="square" style="background-color: yellow; color: black">{{ review.reviewScore }}</h3>
                            {% else %}
                                <h3 class="square" style="background-color: green;">{{ review.reviewScore }}</h3>
                            {% endif %}
                            <p>{{ review.reviewDetails }}</p>
                            <a href="{{ path('app_edit_review', { id: review.id }) }}" class="btn btn-success mb-2">Edit Review</a>
                            <form action="{{ path('app_delete_review', {id: review.id}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this review?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ review.id) }}">
                                <button class="btn btn-danger">Delete Review</button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </main>
{% endblock %}
