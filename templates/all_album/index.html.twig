{% extends 'base.html.twig' %}

{% block title %}Albums{% endblock %}

{% block body %}
<h1>Albums</h1>
    <table class="albums-table table custom-table table-hover">
        <tr>
            <th>Album</th>
            <th>Title</th>
            <th>Artist</th>
            <th>Release Date</th>
            <th>Review</th>
        </tr>
        {% for album in albums %}
        <tr>
            {% if album.coverImage is not null %}
                <td><img src="{{ asset('uploads/cover_image/' ~ album.coverImage) }}" class="albumTable-img"></td>
            {% else %}
                <td><img src="{{ asset('uploads/cover_image/default-album.jpg') }}" class="albumTable-img"></td>
            {% endif %}
            <td><a href="{{ path('app_view_album', { id: album.id }) }}">{{ album.albumName }}</a></td>
            <td>
                {% if album.artistID is not null %}
                {{ album.artistID.name }}
                {% else %}
                    <p>UNKNOWN</p>
                {% endif %}
            </td>
            <td>{{ album.ReleaseDate }}</td>

            <td>
                {% if album.getAverageReviewScore() <= 1 %}
                    <h5 class="square" style="background-color: indianred;">{{ album.getAverageReviewScore()|number_format(2) }}</h5>
                {% elseif album.getAverageReviewScore() < 4 %}
                    <h5 class="square" style="background-color: yellow; color: black">{{ album.getAverageReviewScore()|number_format(2) }}</h5>
                {% else %}
                    <h5 class="square" style="background-color: green;">{{ album.getAverageReviewScore()|number_format(2) }}</h5>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </table>
{% endblock %}
