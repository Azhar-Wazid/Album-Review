{% extends 'base.html.twig' %}

{% block title %}{{ album.albumName }}{% endblock %}

{% block body %}
<main>
    <div class="container mt-3">
        <div class="row align-items-start">
            <div class="col">
                {% if album.coverImage is not null %}
                    <img src="{{ asset('uploads/cover_image/' ~ album.coverImage) }}" class="album-img">
                {% else %}
                    <img src="{{ asset('uploads/cover_image/default-album.jpg') }}" class="album-img">
                {% endif %}

                {% if (app.user and app.user.id and app.user.id == album.userID.id) or is_granted('ROLE_MOD') %}
                    <div>
                        {{ form_start(editImageForm) }}
                            {{ form_widget(editImageForm.coverImage) }}
                            <button type="submit" class="btn btn-success mb-3">Save</button>
                        {{ form_end(editImageForm) }}
                    </div>
                    {% if (app.user and app.user.id and app.user.id == album.userID.id) or is_granted('ROLE_ADMIN') %}
                        <form action="{{ path('app_delete_album', {id: album.id}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this album?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_album_' ~ album.id) }}">
                            <button class="btn btn-danger">Delete Album</button>
                        </form>
                    {% endif %}
                {% endif %}

                <h1 class="font-weight-bold">{{ album.albumName }}</h1>
                <p>
                    {% if album.artistID is not null %}
                    {{ album.artistID.name }}
                    {% else %}
                    UNKNOWN
                    {% endif %} &#x2022; {{ album.releaseDate }}
                </p>
                {% if averageReviewScore <= 1 %}
                    <h2 class="square" style="background-color: indianred;">{{ averageReviewScore|number_format(2) }}</h2>
                {% elseif averageReviewScore < 4 %}
                    <h2 class="square" style="background-color: yellow; color: black">{{ averageReviewScore|number_format(2) }}</h2>
                {% else %}
                    <h2 class="square" style="background-color: green;">{{ averageReviewScore|number_format(2) }}</h2>
                {% endif %}
            </div>
            <div class="col text-right">
                <table class="table custom-table">
                    <tr>
                        <th>#</th>
                        <th>Track</th>
                        <th>Duration</th>
                    </tr>
                    {% for track in tracks %}
                    <tr>
                        <td>{{ track.trackNumber }}</td>
                        <td>{{ track.title }}</td>
                        <td>{{ track.duration }}</td>
                    </tr>
                    {% endfor %}
                </table>
            </div>
        </div>

        <div class="row align-items-start mt-3" style="display: flex; flex-direction: row-reverse">
            {% if app.user %}
                <button type="button" class="btn btn-success" style="width: 200px;" id="addReview">Add Review</button>
            {% else %}
                <p>Login to Review</p>
            {% endif %}
        </div>
        <div class="mt-3" style="display: none;" id="addReviewForm">
            {{ form_start(form, { attr: {id: 'reviewForm'}}) }}
                {{ form_row(form.reviewScore) }}
                {{ form_widget(form.reviewDetails) }}
                <button type="submit" class="btn btn-success mt-3 me-1" id="submitReview">Submit</button>
                <button type="button" class="btn btn-danger mt-3" id="cancelReview">Cancel</button>
            {{ form_end(form) }}
        </div>

        <div class="mt-3" id="reviewList">
            {% for review in  reviews %}
                <div class="card mb-2">
                    <div class="card-body" style="background-color: var(--primary) !important; color: white !important; border-color: gray !important; border-radius: 5px !important;">
                        <p>
                        {% if review.userID.profilePicture is not null %}
                            <img src="{{ asset('uploads/profile_picture/' ~ review.userID.profilePicture) }}" class="profile-Icon">
                        {% else %}
                            <img src="{{ asset('uploads/profile_picture/defaultpfp.jpg') }}" class="profile-Icon">
                        {% endif %}

                        <b>{{ review.userID.username }}</b>
                        </p>
                        {% if review.reviewScore <= 1 %}
                            <h3 class="square" style="background-color: indianred;">{{ review.reviewScore }}</h3>
                        {% elseif review.reviewScore < 4 %}
                            <h3 class="square" style="background-color: yellow; color: black">{{ review.reviewScore }}</h3>
                        {% else %}
                            <h3 class="square" style="background-color: green;">{{ review.reviewScore }}</h3>
                        {% endif %}
                        <p>{{ review.reviewDetails }}</p>
                        {% if is_granted('ROLE_MOD') in app.user.roles %}
                            <form action="{{ path('app_delete_review', {id: review.id}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this review?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ review.id) }}">
                            <button class="btn btn-danger">Delete Review</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</main>

    <script>
        const addReviewButton = document.getElementById('addReview');
        const cancelReviewButton = document.getElementById('cancelReview');
        const addReviewFormButton = document.getElementById('addReviewForm');
        const reviewList = document.getElementById('reviewList');

        addReviewButton.addEventListener('click', () => {
            addReviewFormButton.style.display = 'block';
            addReviewButton.style.display = 'none';
        });

        cancelReviewButton.addEventListener('click', () => {
            addReviewFormButton.style.display = 'none';
            addReviewButton.style.display = 'block';
        });


        document.getElementById('reviewForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const form = e.target;
            const formData = new FormData(form);

            const response = await fetch(form.action, {
                method: 'POST',
                body: formData
            });
            const responseJSON = await response.json();
            //console.log(responseJSON);

            if(responseJSON.success) {
                const reviewList = document.getElementById('reviewList');
                reviewList.insertAdjacentHTML("afterbegin", `<div class="card mb-2">
                    <div class="card-body" style="background-color: var(--primary) !important; color: white !important; border-color: gray !important; border-radius: 5px !important;">
                        <h2>${ responseJSON.reviewScore }/5</h2>
                        <p>${ responseJSON.reviewDetails }</p>
                    </div>
                </div>`)
            }

            form.reset();
            addReviewFormButton.style.display = 'none';
            addReviewButton.style.display = 'block';
        });
    </script>
{% endblock %}
